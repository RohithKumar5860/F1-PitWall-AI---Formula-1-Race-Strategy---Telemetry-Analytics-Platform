# ──────────────────────────────────────────────────────────────────
# F1 PitWall AI — Environment Configuration Template
# Copy this file to .env and fill in real values before running.
# The .env file is git-ignored and must NOT be committed.
# ──────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────
APP_NAME=F1 PitWall AI
APP_ENV=development
DEBUG=True

# ── Database (optional for local dev) ────────────────────────────
# Leave DATABASE_URL unset to run without PostgreSQL (in-memory auth).
# Set to a real PostgreSQL URL to enable persistent database features.
# DATABASE_URL=postgresql://f1user:YOUR_DB_PASSWORD@localhost:5432/f1_pitwall

# ── Docker Compose PostgreSQL credentials ────────────────────────
# These are used by docker-compose.yml. Required for Docker deployment.
POSTGRES_USER=f1user
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=f1_pitwall

# ── Security ─────────────────────────────────────────────────────
# SECRET_KEY must be at least 32 random characters for HMAC-SHA256.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# WARNING: Do NOT use the example value below in production!
SECRET_KEY=CHANGE_ME_generate_with_python_secrets_token_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── CORS ─────────────────────────────────────────────────────────
# Comma-separated allowed origins. Use * for development only.
# Example: http://localhost:8501,http://127.0.0.1:8501
CORS_ORIGINS=*

# ── FastF1 Cache ─────────────────────────────────────────────────
# Relative to project root. Created automatically on first run.
FASTF1_CACHE_DIR=data/cache

# ── Backend server ────────────────────────────────────────────────
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# ── Streamlit → Backend URL ───────────────────────────────────────
# Must match BACKEND_HOST and BACKEND_PORT above.
# In Docker, set to: http://backend:8000
BACKEND_URL=http://127.0.0.1:8000
