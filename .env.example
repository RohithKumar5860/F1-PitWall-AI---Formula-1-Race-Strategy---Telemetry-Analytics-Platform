# ──────────────────────────────────────────────────────────────────
# F1 PitWall AI — Environment Configuration Template
# Copy this file to .env and fill in real values before running.
# The .env file is git-ignored and must NOT be committed.
# ──────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────
APP_NAME=F1 PitWall AI
APP_ENV=development
DEBUG=True

# ── Database (optional) ──────────────────────────────────────────
# Leave DATABASE_URL unset to run without PostgreSQL (in-memory auth).
# Set to a real PostgreSQL URL to enable persistent database features.
# DATABASE_URL=postgresql://f1admin:f1password@localhost:5432/f1_pitwall

# ── Security ─────────────────────────────────────────────────────
# SECRET_KEY must be at least 32 random characters for HMAC-SHA256.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-32-plus-character-random-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── FastF1 Cache ─────────────────────────────────────────────────
# Relative to project root. Created automatically on first run.
FASTF1_CACHE_DIR=data/cache

# ── Backend server ────────────────────────────────────────────────
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# ── Streamlit → Backend URL ───────────────────────────────────────
# Must match BACKEND_HOST and BACKEND_PORT above.
# In Docker, set to: http://backend:8000
BACKEND_URL=http://127.0.0.1:8000
